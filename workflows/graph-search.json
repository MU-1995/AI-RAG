    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7474/db/neo4j/query/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\nJSON.stringify({\n  \"statement\": \"MATCH (r:Recipe) OPTIONAL MATCH (r)-[:CONTAINS]->(i:Ingredient) WITH r, collect(i.name) AS ingredients OPTIONAL MATCH (r)-[:BELONGS_TO]->(c:Category) WITH r, ingredients, collect(c.name) AS categories WHERE (coalesce($ingredient, '') = '' OR toLower(r.name) CONTAINS toLower($ingredient) OR any(x IN ingredients WHERE toLower(x) CONTAINS toLower($ingredient))) AND (coalesce($category, '') = '' OR any(cat IN categories WHERE toLower(cat) CONTAINS toLower($category))) RETURN r.name AS recipe, r.description AS description, ingredients, categories ORDER BY recipe\",\n  \"parameters\": {\n    \"ingredient\": $json.ingredient,\n    \"category\": $json.category\n  }\n})\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
